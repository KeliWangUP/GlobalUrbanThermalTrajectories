{
  "project": {
    "gee_project": "ee-keliwang",
    "version": "v0.3"
  },

  "study": {
    "start_year": 2000,
    "end_year": 2024
  },

  "sample_points": {
    "selection_rule": "center_in_city",
    "include_lonlat": true,
    "city_batch_size": 50
  },

  "processing": {
    "tile_scale": 4
  },

  "test": {
    "city_id": 5249,
    "year": 2020,
    "fraction_diagnostic_city_id": 5929
  },

  "reference_grid": {
    "collection": "MODIS/061/MOD11A1",
    "band": "LST_Day_1km",
    "reference_date": "2001-01-01",
    "pixel_id_prefix": "MODIS"
  },

  "cities": {
    "asset": "users/keliwang/urban_expansion/GHSL_urban_bounds_2024",
    "id_field": "ID_UC_G0",
    "boundary_definition": "fixed_2024",
    "priority_points_asset": "projects/ee-keliwang/assets/cities_over_300k"
  },

  "ghsl_built": {
    "years": [2000, 2005, 2010, 2015, 2020],
    "scale_m": 100,
    "area_max_error_m": 10,
    "built_surface_collection": "JRC/GHSL/P2023A/GHS_BUILT_S",
    "built_surface_band": "built_surface",
    "built_volume_collection": "JRC/GHSL/P2023A/GHS_BUILT_V",
    "built_volume_band": "built_volume_total"
  },

  "samplepoint_attributes": {
    "isa_asset": "projects/ee-keliwang/assets/gaia_global_isa_2021",
    "isa_band": null,
    "isa_years": [
      1985, 1986, 1987, 1988, 1989, 1990, 1991, 1992, 1993, 1994,
      1995, 1996, 1997, 1998, 1999, 2000, 2001, 2002, 2003, 2004,
      2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014,
      2015, 2016, 2017, 2018, 2019, 2020, 2021
    ],
    "water_band": "WBM",
    "max_pixels_per_cell": 4096
  },

  "batches": {
    "tile_pixels": 1200,
    "tile_columns": 36,
    "tile_rows": 18
  },

  "modis": {
    "scale_factor": 0.02,
    "kelvin_offset": -273.15,

    "monthly_assignment": "composite_midpoint",
    "monthly_weighting": "clear_sky_count",

    "qa": {
      "apply_qa_mask": false,
      "mandatory_qa_max": 1,
      "max_lst_error_code": 1,
      "require_good_data_quality": false
    },

    "slots": {
      "terra_day": {
        "collection": "MODIS/061/MOD11A2",
        "lst_band": "LST_Day_1km",
        "qc_band": "QC_Day",
        "clear_band": "Clear_sky_days"
      },

      "terra_night": {
        "collection": "MODIS/061/MOD11A2",
        "lst_band": "LST_Night_1km",
        "qc_band": "QC_Night",
        "clear_band": "Clear_sky_nights"
      },

      "aqua_day": {
        "collection": "MODIS/061/MYD11A2",
        "lst_band": "LST_Day_1km",
        "qc_band": "QC_Day",
        "clear_band": "Clear_sky_days"
      },

      "aqua_night": {
        "collection": "MODIS/061/MYD11A2",
        "lst_band": "LST_Night_1km",
        "qc_band": "QC_Night",
        "clear_band": "Clear_sky_nights"
      }
    }
  },

  "rural": {
    "inner_buffer_m": 2000,
    "outer_buffer_m": 10000,
    "max_error_m": 100,
    "max_slope_deg": 5,

    "gaia_asset": "Tsinghua/FROM-GLC/GAIA/v10",
    "dem_collection": "COPERNICUS/DEM/GLO30_2024_1",

    "minimum_rural_fraction_per_modis_pixel": 0.8,
    "static_assets": {
      "halo_asset": "projects/ee-keliwangpy/assets/GlobalUrbanThermalTrajectories/rural_halos_fixed2024_v0_3",
      "halo_asset_description": "rural_halos_fixed2024_v0_3",
      "city_fraction_collection_asset": "projects/ee-keliwangpy/assets/GlobalUrbanThermalTrajectories/rural_fraction_by_city_direct_v0_4",
      "processing_buffer_modis_pixels": 2,
      "max_source_pixels_per_modis_pixel": 32768,
      "fraction_value_scale": 10000,
      "export_max_pixels": 100000000
    }
  },

  "export": {
    "asset_root": "projects/ee-keliwangpy/assets/GlobalUrbanThermalTrajectories/modis_sample_points",
    "sample_points_description": "modis_sample_points",
    "overwrite_sample_points": false,
    "folder": "GlobalUrbanThermalTrajectories",
    "partition": "year",
    "targets": [
      "samplepoint_attributes"
    ],
    "city_dataset_name": "city_lst_fixed2024",
    "samplepoint_lst_dataset_name": "samplepoint_lst_monthly",
    "rural_priority_dataset_name": "rural_lst_over_300k",
    "rural_all_cities_dataset_name": "rural_lst_all_cities",
    "ghsl_built_dataset_name": "ghsl_built_city_development_2000_2020",
    "samplepoint_attributes_dataset_name": "samplepoint_isa_ghsl_water",
    "rural_city_ids": null,
    "rural_city_fraction_priority_only": false,
    "rural_city_fraction_chunked_ids": [
      5929,
      6090
    ],
    "rural_city_fraction_chunk_pixels": 64,
    "rural_city_fraction_max_tasks_per_run": 3000
  }
}